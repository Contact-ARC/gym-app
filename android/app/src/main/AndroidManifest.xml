<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App-icon shortcuts open gymcrew://start-next and gymcrew://progress -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="gymcrew" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Puts the rest countdown back if it's swiped away while time is left -->
        <receiver android:name=".RestCountdownReceiver" android:exported="false" />
        <!-- Swaps the countdown for the "Get ready" alert when the rest is over -->
        <receiver android:name=".RestAlarmReceiver" android:exported="false" />
        <!-- Runs only while you're out of the app mid-rest, so the phone doesn't freeze the app
             before the "Get ready" alert is due. Its notification is the rest countdown. -->
        <service
            android:name=".RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rest timer between gym sets: shows the time left and alerts when the next set is due" />
        </service>

        <!-- Crew notifications (Firebase): the dumbbell in the status bar, in the app's blue -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_rest" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/crew_push" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="crew_workouts" />

        <!-- Health Connect (0.13): its permission screen links here for the privacy policy (Android 13 and older) -->
        <activity
            android:name=".HealthPrivacyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- … and on Android 14+ -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Health Connect (0.13): only what Settings → Health Connect asks for; each is the person's choice on
         Health Connect's own screen. Writes: workouts (+ treadmill distance), weight, body fat, height.
         Reads: weight and body fat from other apps, heart rate during workouts, steps. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- To find the Health Connect app on Android 13 and older -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <!-- The "Get ready" alert at the end of a rest has to arrive on time, not minutes late.
         Granted at install (no prompt) on Android 13+; the app isn't on Google Play, whose policy limits it to alarm apps. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 16: lets the rest countdown show as a Live Update (time in a status-bar chip) where supported -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The rest timer's foreground service (see RestTimerService) -->
    <!-- Keeps the rest timer running while the phone is locked (only during a rest, out of the app) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Automatic backups to Documents/GymCrew. Only needed on Android 9 and older;
         newer versions let the app write its own files there without asking. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
